# 보통은 루트 .env 하나만 쓴다 (모든 서비스가 읽는다). 이 파일은 서비스만 따로 띄울 때의 참고용이고, 여기 둔 값은 루트 값보다 우선한다.
APP_ENV=dev
# file | postgis | postgis_memory
GRAPH_SOURCE=file
GRAPH_BUNDLE_PATH=../data/samples/grid_city.npz
BUILDINGS_PATH=../data/samples/grid_city_buildings.json
DATABASE_URL=postgresql://pathfinder:pathfinder_dev@localhost:5432/pathfinder
ENGINE_TIME_BUDGET_S=2.5
ACO_ANTS=24
ACO_ITERATIONS=60
GA_GENERATIONS=25
LOG_LEVEL=INFO

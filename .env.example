# ---------- 공통: 이 파일 하나(루트 .env)를 모든 서비스가 읽는다 ----------
#   cp .env.example .env  →  값 채우기  →  python scripts/doctor.py 로 점검  →  docker compose up --build
# 키가 하나도 없어도 뜬다(샘플 격자 도시 + OSM 배경 + 로컬 장소 색인). 키를 넣고 재시작하면 그 기능이 켜진다.
# 로컬(컨테이너 없이) 실행이면 호스트 'db' 를 'localhost' 로 바꾼다. 백엔드·엔진이 드라이버 접두어를 알아서 맞추므로 한 줄만 쓴다.
POSTGRES_DB=pathfinder
POSTGRES_USER=pathfinder
POSTGRES_PASSWORD=pathfinder_dev
DATABASE_URL=postgresql://pathfinder:pathfinder_dev@db:5432/pathfinder

# ---------- 운영 배포 (docker-compose.prod.yml) ----------
# 공개 주소. 비우면 http://<서버IP>(80 포트), https://도메인 을 넣으면 Caddy 가 Let's Encrypt 인증서를 자동 발급한다.
# 카카오·네이버 Redirect URI 와 VWorld 서비스 URL 도 이 주소로 등록한다. (개발 compose 는 이 값을 쓰지 않는다)
SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443
# 백업 보관 일수 (--profile ops backup)
KEEP_DAYS=14

# ---------- backend ----------
ENGINE_URL=http://engine:8001
ENGINE_TIMEOUT_S=30
CORS_ORIGINS=http://localhost:5173
# Kakao Developers > 앱 키 > REST API 키 (장소 검색)
KAKAO_REST_API_KEY=
# 날씨 공급자: open_meteo(키 불필요, 기본) | openweather
WEATHER_PROVIDER=open_meteo
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_S=300
# 로그인 (카카오·네이버 OAuth). Redirect URI: {PUBLIC_BASE_URL}/api/auth/{kakao|naver}/callback
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
JWT_SECRET=change-me-to-a-long-random-string
# 개발 compose 전용. 운영(docker-compose.prod.yml)은 데모 로그인을 항상 끄고, https 면 Secure 쿠키를 자동으로 쓴다
COOKIE_SECURE=false
ALLOW_DEV_LOGIN=true
# 개인화(RL)
PERSONALIZATION_ENABLED=true
PERSONALIZATION_EPSILON=0.1

# ---------- engine ----------
# auto(권장: PostGIS 에 그래프가 있으면 그것 → 없으면 data/build 산출물 → 없으면 샘플 격자) | file | postgis | postgis_memory
GRAPH_SOURCE=auto
GRAPH_BUILD_DIR=../data/build
GRAPH_BUNDLE_PATH=data/samples/grid_city.npz
BUILDINGS_PATH=data/samples/grid_city_buildings.json
ENGINE_TIME_BUDGET_S=2.5

# ---------- pipeline (오프라인 빌드, 사용자 PC) ----------
OSM_PBF_PATH=data/raw/south-korea-latest.osm.pbf
# 공공데이터포털 부산 BIMS 인증키(Decoding). 버스 노선·정류장 순서 수집용
BUS_SERVICE_KEY=
# VWorld 오픈API 키(선택). 건물 실측 높이
VWORLD_API_KEY=

# ---------- frontend ----------
# Kakao Developers > 앱 키 > JavaScript 키
# 배경 지도: VWorld(국토교통부) 인증키. 비우면 OpenFreeMap(OSM 벡터)을 쓴다. https://www.vworld.kr 에서 발급·도메인 등록
VITE_VWORLD_KEY=
# MapLibre 스타일 URL 을 직접 지정하려면 (선택)
VITE_BASEMAP_STYLE_URL=
VITE_BACKEND_URL=http://localhost:8000

# ---- 관리자 페이지 (/admin) ----
# 비어 있으면 관리자 기능이 꺼진다. 운영에서는 길고 무작위한 값을 쓴다.
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_S=300
# 모든 /api 호출을 api_access_logs 에 기록
ACCESS_LOG_ENABLED=true
# 접근 로그·장소 검색·엔진 성능 로그 보존 일수 (0 이면 지우지 않음). 하루 한 번 자동 정리
LOG_RETENTION_DAYS=90
# ---- 관측성·캐시·제보·알림 ----
METRICS_ENABLED=true
LOG_FORMAT=text
SEARCH_CACHE_TTL_S=600
REPORT_RATE_LIMIT_PER_HOUR=20
# 임계 초과 알림: Slack 수신 웹훅(Incoming Webhook) URL. 관리자 화면(/admin/alerts)에서 넣어도 되고, 거기서 저장한 값이 우선한다
ALERT_WEBHOOK_URL=
ALERT_ENABLED=true
ALERT_INTERVAL_MIN=5

# 보통은 루트 .env 하나만 쓴다 (모든 서비스가 읽는다). 이 파일은 서비스만 따로 띄울 때의 참고용이고, 여기 둔 값은 루트 값보다 우선한다.
# Kakao Developers > 앱 키 > JavaScript 키. 없으면 SVG 약식 지도로 동작
# 배경 지도: VWorld(국토교통부) 인증키. 비우면 OpenFreeMap(OSM 벡터)을 쓴다. https://www.vworld.kr 에서 발급·도메인 등록
VITE_VWORLD_KEY=
# MapLibre 스타일 URL 을 직접 지정하려면 (선택)
VITE_BASEMAP_STYLE_URL=
# 비워 두면 같은 오리진의 /api 사용 (vite dev 프록시 / nginx). 직접 지정 시 예: http://localhost:8000
VITE_BACKEND_URL=

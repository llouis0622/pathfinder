APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://pathfinder:pathfinder_dev@localhost:5432/pathfinder
ENGINE_URL=http://localhost:8001
ENGINE_TIMEOUT_S=30
# Kakao Developers > 앱 키 > REST API 키. 없으면 로컬 역·정류장 색인만 검색
KAKAO_REST_API_KEY=
# open_meteo(키 불필요) | openweather | none
WEATHER_PROVIDER=open_meteo
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_S=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 로그인 (카카오·네이버 OAuth). Redirect URI: {PUBLIC_BASE_URL}/api/auth/{kakao|naver}/callback
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
ALLOW_DEV_LOGIN=true
# 개인화(RL)
PERSONALIZATION_ENABLED=true
PERSONALIZATION_EPSILON=0.1
LOG_LEVEL=INFO

# ---- 관리자 페이지 (/admin) ----
# 비어 있으면 관리자 기능이 꺼진다. 운영에서는 길고 무작위한 값을 쓴다.
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=12
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_LOCKOUT_S=300
# 모든 /api 호출을 api_access_logs 에 기록
ACCESS_LOG_ENABLED=true
# 접근 로그·장소 검색·엔진 성능 로그 보존 일수 (0 이면 지우지 않음). 하루 한 번 자동 정리
LOG_RETENTION_DAYS=90

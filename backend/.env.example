APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://pathfinder:pathfinder_dev@localhost:5432/pathfinder
ENGINE_URL=http://localhost:8001
ENGINE_TIMEOUT_S=30
# Kakao Developers > 앱 키 > REST API 키. 없으면 로컬 역·정류장 색인만 검색
KAKAO_REST_API_KEY=
# open_meteo(키 불필요) | openweather | none
WEATHER_PROVIDER=open_meteo
OPENWEATHER_API_KEY=
WEATHER_CACHE_TTL_S=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 로그인 (카카오·네이버 OAuth). Redirect URI: {PUBLIC_BASE_URL}/api/auth/{kakao|naver}/callback
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
ALLOW_DEV_LOGIN=true
# 개인화(RL)
PERSONALIZATION_ENABLED=true
PERSONALIZATION_EPSILON=0.1
LOG_LEVEL=INFO
